{
    "name": "bumbummen99/shoppingcart",
    "description": "Laravel Shoppingcart",
    "keywords": ["laravel", "shoppingcart"],
    "license": "MIT",
    "authors": [
        {
            "name": "Niek Brekelmans",
            "email": "niekb@thor.edu"
        },
        {
            "name": "Rob Gloudemans",
            "email": "info@robgloudemans.nl",
            "homepage": "http://robgloudemans.nl/"
        },
        {
            "name": "Patrick Henninger",
            "email": "privat@skyraptor.eu",
            "homepage": "https://skyraptor.eu/"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/events": "^12.0||^13.0",
        "illuminate/session": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "adamwojs/php-cs-fixer-phpdoc-force-fqcn": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.66",
        "larastan/larastan": "^3.9",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0||^11.0",
        "phpunit/phpunit": "^12.0||^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gloudemans\\Shoppingcart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gloudemans\\Tests\\Shoppingcart\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Gloudemans\\Shoppingcart\\ShoppingcartServiceProvider"
            ],
            "aliases": {
                "Cart": "Gloudemans\\Shoppingcart\\Facades\\Cart"
            }
        }
    }
}
